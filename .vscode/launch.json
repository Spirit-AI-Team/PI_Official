{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pi0_LeRobot_Converter",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/examples/libero/convert_libero_data_to_lerobot.py",
            "args": [
                "--data_dir", "/hy-tmp/likaiyu/resources/modified_libero_rlds",
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": "false",
            // "pythonPath": "${config:python.pythonPath}"
        },
        {
            "name": "Pi0_LeRobot_Finetune",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train.py",
            "args": [
                // "pi0_libero_simple_test",
                "spi0_aloha_dieyifu",
                "--exp-name=my_experiment", 
                // "--overwrite",
                "--resume",
            ],
            "console": "integratedTerminal",
            "env": {
                "XLA_PYTHON_CLIENT_MEM_FRACTION":"0.9",
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES":"1",
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": "false",
            // "pythonPath": "${config:python.pythonPath}"
        },
        {
            "name": "Pi0_LeRobot_Compute_Norm",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/compute_norm_stats.py",
            "args": [
                // "pi0_libero_simple_test",
                "--config_name",
                "spi0_aloha_dieyifu",
            ],
            "console": "integratedTerminal",
            "env": {
                "XLA_PYTHON_CLIENT_MEM_FRACTION":"0.9",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": "false",
            // "pythonPath": "${config:python.pythonPath}"
        }
    ]
}



// uv run scripts/compute_norm_stats.py --config-name pi0_fast_libero